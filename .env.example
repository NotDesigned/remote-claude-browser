# Server settings, one line each; docs/configuration.md describes every variable.
# scripts/bootstrap.sh writes .env for you, with a random password and secret.

# Compose files. compose.runtime.yml is required to open any browser profile; see docs/deployment.md.
COMPOSE_FILE=compose.yml:compose.runtime.yml

# Initial administrator's password, used only while the user database is empty.
MIRROR_ACCESS_PASSWORD=replace-with-a-long-random-password
# Initial administrator's user name, used only while the user database is empty.
MIRROR_ADMIN_USERNAME=admin
# Required, at least 16 characters; keep it stable. Generate with: openssl rand -hex 32
MIRROR_AUTH_SECRET=
# Required: the exact origin people open, such as https://browser.example.com
# (http://127.0.0.1:3010 for local evaluation). The server refuses to start without it.
MIRROR_PUBLIC_ORIGIN=

# Optional single sign-on through an OpenID Connect provider (e.g. authentik), next to username and
# password. Register a confidential client with redirect URI <MIRROR_PUBLIC_ORIGIN>/gate/oidc/callback,
# authorization code + PKCE (S256), scopes "openid profile email". The first sign-in creates a user;
# who may sign in is decided by the provider (and the optional allow-lists). See docs/configuration.md.
MIRROR_OIDC_ISSUER=
MIRROR_OIDC_CLIENT_ID=
MIRROR_OIDC_CLIENT_SECRET=
# Button text on the sign-in page.
MIRROR_OIDC_LABEL=
# Members of this group (groups claim) are administrators of users created by sign-in.
MIRROR_OIDC_ADMIN_GROUP=
# Optional extra checks for first sign-ins: comma-separated; domains/emails need a verified email.
MIRROR_OIDC_ALLOWED_DOMAINS=
MIRROR_OIDC_ALLOWED_EMAILS=
MIRROR_OIDC_ALLOWED_GROUPS=
# Sessions started by sign-in last 7 days; remote-cc of users without a password needs a sign-in
# within 30 days.
MIRROR_OIDC_SESSION_DAYS=
MIRROR_OIDC_REVALIDATE_DAYS=

# Host address the gateway is published on. Keep loopback behind a reverse proxy or tunnel.
SERVER_BIND=127.0.0.1
# Host port the gateway is published on.
SERVER_PORT=3010
# The page a new session opens.
MIRROR_START_URL=https://claude.ai/

# Resend API key for the mailboxes.
# RESEND_API_KEY=
# Resend webhook signing secret.
# RESEND_WEBHOOK_SECRET=
# Comma-separated receiving domains; the first is the default.
# RESEND_RECEIVING_DOMAIN=
# Verified sender for binding existing addresses.
# RESEND_VERIFICATION_FROM=

# Container memory limit.
SERVER_MEMORY=4g
# Memory plus swap; 0 leaves it to Docker.
SERVER_MEMSWAP=0
# CPUs; 0 leaves them to Docker.
SERVER_CPUS=0
# Processes and threads combined.
SERVER_PIDS_LIMIT=4096
# Time zone of the service processes and logs. Browsers follow their exit's time zone.
TZ=Etc/UTC
# This host's public IP, comma-separated, so pages cannot reach it.
EGRESS_BLOCK=

# A prebuilt server image. Unset, Compose builds from this checkout.
# SERVER_IMAGE=
# Installed AliasMode directory, for compose.fingerprint.yml.
# FINGERPRINT_BROWSER_DIR=/absolute/path/to/aliasmode-155.0.8059.85
# Windows and macOS fonts for AliasMode personas, for compose.fingerprint.yml (scripts/fingerprint-fonts.sh).
# FINGERPRINT_FONTS_DIR=./local/fingerprint-fonts
# Browser engine for new profiles, for compose.fingerprint.yml.
# MIRROR_BROWSER_ENGINE=aliasmode

# Public host name, only for compose.https.yml.
# PUBLIC_HOST=browser.example.com

# Outside proxy share link or Xray outbound JSON, only for compose.proxy.yml.
# EGRESS_PROXY='vless://uuid@proxy.example.com:443?encryption=none&security=reality&sni=example.com&pbk=...&sid=...'
# DNS server that resolves the proxy's own name, only for compose.proxy.yml.
# EGRESS_BOOTSTRAP_DNS=1.1.1.1

# Internal Docker network of the CPA instances, for compose.runtime.yml.
# CPA_RUNTIME_NETWORK=remote-browser-cpa-runtime
# CPA engine image, for compose.runtime.yml.
# CPA_BROKER_ENGINE_IMAGE=remote-claude-browser-cpa:local
# cpa-broker image, for compose.runtime.yml.
# CPA_BROKER_IMAGE=remote-claude-browser-cpa-broker:local
