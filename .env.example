# Server settings. `scripts/bootstrap.sh` writes .env for you, with random values for the secrets.

# Required by Compose. Used only to initialize the administrator when the SQLite database is empty.
# After initialization, reset passwords in user management; changing this does not reset users.
# This service's credentials are separate from accounts on visited sites. Use a long, unique password.
MIRROR_ACCESS_PASSWORD=replace-with-a-long-random-password
# Only used when creating the initial administrator; does not rename an existing user.
MIRROR_ADMIN_USERNAME=admin

# Required, at least 16 characters each, and different from each other. Keep them stable.
# Rotating these keys does not revoke front-end logins stored in SQLite; manage users to revoke them.
# Generate each with: openssl rand -hex 32
MIRROR_ACCESS_SECRET=
MIRROR_AUTH_SECRET=

# The exact origin people open, such as https://browser.example.com. WebSocket connections from any
# other origin are refused. Empty turns that check off, which only suits local evaluation.
MIRROR_PUBLIC_ORIGIN=

# Where the gateway is published on this host. Keep loopback behind a tunnel or reverse proxy.
SERVER_BIND=127.0.0.1
SERVER_PORT=3010

# Global session capacity across all front-end users. Any positive safe integer; default 8.
# This does not limit online clients or picture-mode sessions. Reducing it keeps existing sessions.
MIRROR_CLIENTS=8
# The page a new session opens.
MIRROR_START_URL=https://claude.ai/new
# Memory limit for the container. New sessions are refused as it runs short.
SERVER_MEMORY=4g
# Memory plus swap, and CPUs. 0 leaves them to Docker.
SERVER_MEMSWAP=0
SERVER_CPUS=0
# The browser's timezone, an IANA name such as Asia/Shanghai. Unset means UTC. Sites compare it
# with where your IP appears to be, so set it to match the server's location.
TZ=Etc/UTC

# The container's firewall already blocks private networks. Add this host's public IP, which the
# container cannot see for itself, to keep pages from reaching services on it. Comma-separated.
EGRESS_BLOCK=

# A prebuilt image. Unset, Compose builds from this checkout.
# SERVER_IMAGE=

# Only for compose.https.yml, which runs Caddy on this host.
# PUBLIC_HOST=browser.example.com
