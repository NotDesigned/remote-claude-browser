# The domain people open. It must point at this host for Caddy to get a certificate.
PUBLIC_HOST=browser.example.com

# How this host reaches the server over SSH.
SERVER_SSH_HOST=server.example.com
SERVER_SSH_PORT=22
SERVER_SSH_USER=root

# The gateway's port on the server's loopback, SERVER_PORT in the server's .env.
SERVER_PORT=3010

# Published ports. Change them if this host already runs something on 80 and 443.
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# A prebuilt tunnel image. Unset, Compose builds it from this directory.
# TUNNEL_IMAGE=
