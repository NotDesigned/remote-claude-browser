# CPA remains a separate, unmodified program. Node is used only for initialization and probes.
FROM eceasy/cli-proxy-api:v8.0.68@sha256:bc9718d3c716aa3af7c58fe991e7df5a8ef41ea612e665a2c4d61d1666547dcc AS upstream

FROM node:26.13.0-bookworm-slim AS xray
ARG TARGETARCH=amd64
COPY deploy/fetch-xray.mjs /tmp/
RUN node /tmp/fetch-xray.mjs "$TARGETARCH" /opt/xray

FROM node:26.13.0-bookworm-slim AS base
ENV NODE_ENV=production
WORKDIR /app
COPY --from=upstream /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --chmod=644 deploy/cpa-runtime.mjs deploy/egress-proxy.mjs /opt/remote-browser/
RUN chmod 0755 /opt/remote-browser

FROM base AS cpa
COPY --from=upstream /CLIProxyAPI/CLIProxyAPI /app/CLIProxyAPI
COPY --chmod=644 deploy/cpa.LICENSE /usr/share/doc/cliproxyapi/LICENSE
RUN chmod 0755 /usr/share/doc/cliproxyapi
ENV HOME=/auth MANAGEMENT_STATIC_PATH=/static
WORKDIR /logs
EXPOSE 8317 54545
USER 10003:10003
CMD ["/app/CLIProxyAPI", "--config", "/config/config.yaml", "--local-model"]

FROM base AS egress
COPY --from=xray /opt/xray/xray /usr/local/bin/xray
COPY --from=xray /opt/xray/LICENSE /usr/share/doc/xray/LICENSE
USER 10002:10002
EXPOSE 1080 8317 54545
CMD ["node", "/opt/remote-browser/cpa-runtime.mjs", "egress"]
