# CPA remains a separate, unmodified program. The broker in Dockerfile.cpa-broker initializes it.
FROM eceasy/cli-proxy-api:v8.1.2@sha256:37733f2a1eaa029e3915a37087b617f85535fe1b25534c8d2cb7f5152e23b02b AS upstream

FROM node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS base
ENV NODE_ENV=production
WORKDIR /app
COPY --from=upstream /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

FROM base AS cpa
COPY --from=upstream /CLIProxyAPI/CLIProxyAPI /app/CLIProxyAPI
COPY --chmod=644 deploy/cpa.LICENSE /usr/share/doc/cliproxyapi/LICENSE
RUN chmod 0755 /usr/share/doc/cliproxyapi
ENV HOME=/auth MANAGEMENT_STATIC_PATH=/static
WORKDIR /logs
EXPOSE 8317 54545
USER 10003:10003
CMD ["/app/CLIProxyAPI", "--config", "/config/config.yaml", "--local-model"]

