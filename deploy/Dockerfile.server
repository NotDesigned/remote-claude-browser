# The server: one container holding Xvfb, Chromium and the gateway, which drives Chromium over a
# private pipe. Nothing here listens for the browser's debugging protocol.
FROM node:26.13.0-bookworm-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH=/pnpm:$PATH
WORKDIR /app

RUN corepack enable \
    && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches patches
COPY packages/agent/package.json packages/agent/package.json
COPY packages/gateway/package.json packages/gateway/package.json
COPY packages/protocol/package.json packages/protocol/package.json
COPY packages/viewer/package.json packages/viewer/package.json
RUN pnpm install --frozen-lockfile

COPY tsconfig.base.json ./
COPY packages packages
RUN pnpm -r --workspace-concurrency=1 --if-present run build \
    && pnpm --filter @mirror/gateway deploy --prod /opt/gateway

# Xray carries the browser's traffic to an outside proxy when EGRESS_PROXY names one.
FROM node:26.13.0-bookworm-slim AS xray
ARG TARGETARCH=amd64
COPY deploy/fetch-xray.mjs /tmp/
RUN node /tmp/fetch-xray.mjs "$TARGETARCH" /opt/xray

FROM node:26.13.0-bookworm-slim AS mihomo
ARG TARGETARCH=amd64
COPY deploy/fetch-mihomo.mjs /tmp/
RUN --mount=type=cache,id=remote-browser-mihomo,target=/var/cache/mihomo \
    MIHOMO_CACHE_DIR=/var/cache/mihomo node /tmp/fetch-mihomo.mjs "$TARGETARCH" /opt/mihomo

FROM node:26.13.0-bookworm-slim AS runtime

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        chromium \
        ffmpeg \
        fonts-dejavu-core \
        fonts-liberation \
        fonts-noto-cjk \
        fonts-noto-color-emoji \
        fonts-noto-core \
        iproute2 \
        iptables \
        procps \
        tzdata \
        x11-utils \
        xauth \
        xdotool \
        xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 browser \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin browser \
    && install -d -o browser -g browser /data \
    && install -d /opt/remote-browser \
    && ln -sfn /data/timezone/localtime /etc/localtime \
    && ln -sfn /data/timezone/name /etc/timezone

# Each browser account keeps a different part of these fonts (packages/gateway/src/browser/identity.ts).
# DEBIAN_MIRROR, e.g. https://mirrors.tuna.tsinghua.edu.cn/debian, replaces deb.debian.org for them.
ARG DEBIAN_MIRROR=
RUN if [ -n "$DEBIAN_MIRROR" ]; then \
        sed -i "s#http://deb.debian.org/debian#$DEBIAN_MIRROR#g" /etc/apt/sources.list.d/debian.sources; \
    fi \
    && for attempt in 1 2 3; do apt-get update && break; sleep 10; done \
    && apt-get install -y --no-install-recommends \
        fonts-arphic-ukai fonts-arphic-uming fonts-cantarell fonts-croscore \
        fonts-crosextra-caladea fonts-crosextra-carlito fonts-droid-fallback fonts-firacode \
        fonts-freefont-ttf fonts-hack fonts-inconsolata fonts-lato fonts-linuxlibertine \
        fonts-noto-mono fonts-noto-ui-core fonts-open-sans fonts-oxygen fonts-roboto fonts-stix \
        fonts-urw-base35 fonts-wqy-microhei fonts-wqy-zenhei \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/gateway/ /app/
COPY --from=build /app/packages/viewer/dist/ /app/viewer/
COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md UPSTREAM_COMMIT /app/
COPY --from=xray /opt/xray/xray /usr/local/bin/xray
COPY --from=xray /opt/xray/LICENSE /usr/share/doc/xray/LICENSE
COPY --from=mihomo /opt/mihomo/mihomo /usr/local/bin/mihomo
COPY deploy/mihomo.LICENSE /usr/share/doc/mihomo/LICENSE
COPY deploy/server-entrypoint.sh deploy/server-egress.sh deploy/egress-tunnel.sh \
    deploy/egress-proxy.mjs deploy/timezone.mjs /opt/remote-browser/
COPY deploy/profile-network.sh /opt/remote-browser/
RUN chmod 0755 /opt/remote-browser/server-entrypoint.sh /opt/remote-browser/server-egress.sh \
    /opt/remote-browser/egress-tunnel.sh /opt/remote-browser/profile-network.sh

# Without a UTF-8 locale Chromium can't name a download in Chinese, which comes out as "download", and
# xwininfo can't print such a window's title, which picture mode finds the window by.
ENV LANG=C.UTF-8
ENV NODE_ENV=production
ENV VIEWER_DIST_ROOT=/app/viewer
ENV CHROME_PATH=/usr/bin/chromium
ENV CHROME_HEADFUL=1
ENV CHROME_USER_DATA_DIR=/data/profile
ENV DISPLAY=:99
ENV HOME=/tmp/home
ENV GATEWAY_HOST=0.0.0.0
ENV GATEWAY_PORT=3010
WORKDIR /app
VOLUME /data
EXPOSE 3010

# Root supervises network setup/cleanup; the gateway and Chromium run as the browser user.
ENTRYPOINT ["/opt/remote-browser/server-entrypoint.sh"]
