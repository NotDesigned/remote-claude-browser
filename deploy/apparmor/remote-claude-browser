# AppArmor profile for the server container (compose.yml: security_opt apparmor=remote-claude-browser).
# Load it on the Docker host with scripts/install-apparmor.sh before starting the server.
#
# It is Docker's default profile (docker-default) with three changes, and nothing else:
#   - the mounts that `ip netns` and deploy/browser-filesystem.sh make are allowed, and only
#     those: each browser profile's network namespace under /run/netns, and its mount namespace
#     built under /run/remote-browser/<exit>/root. docker-default denies every mount. A proc
#     mount is allowed only at that root's proc/, which the /proc rules below cover too, and
#     nothing may be bound from /proc or /sys. pivot_root stays denied (Docker's seccomp profile
#     blocks it as well).
#   - userns is allowed: Chromium's sandbox puts each renderer in a user namespace. On hosts that
#     restrict unprivileged user namespaces (Ubuntu 23.10 and later) only a profile that grants
#     this may create one, so the host-wide sysctl can stay as it is.
#   - signals and ptrace are allowed between processes of this profile.
# The writes docker-default denies under /proc and /sys stay denied.

#include <tunables/global>

# The proc instance browser-filesystem.sh mounts for each browser, seen from the server's own
# mount namespace; inside the browser's namespace it is /proc.
@{PROC}+=/run/remote-browser/*/root/proc/

profile remote-claude-browser flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  userns,

  # ip netns add, exec and del (deploy/profile-network.sh, deploy/profile-broker.mjs).
  mount options=(rw, rshared) -> /run/netns/,
  mount options=(rw, rbind) /run/netns/ -> /run/netns/,
  mount options=(rw, bind) -> /run/netns/*,
  umount /run/netns/*,
  mount options=(rw, rslave) -> /,
  umount /sys/,
  mount fstype=sysfs -> /sys/,

  # unshare --mount and deploy/browser-filesystem.sh, inside each browser's mount namespace.
  mount options=(rw, rprivate) -> /,
  mount fstype=tmpfs -> /run/remote-browser/*/root/{,tmp/,dev/,dev/shm/},
  mount fstype=proc -> /run/remote-browser/*/root/proc/,
  mount options=(rw, bind) -> /run/remote-browser/*/root/**,
  remount /run/remote-browser/*/root/**,
  # Finally every top-level entry is covered with the root's own tree, or with /dev/null.
  mount options=(rw, rbind) /run/remote-browser/*/root/proc/ -> /proc/,
  mount options=(rw, rbind) /run/remote-browser/*/root/{[^p]*,p[^r]*,pr[^o]*,pro[^c]*,proc?*}/ -> /*/,
  mount options=(rw, bind) /dev/null -> /*,

  # The /proc and /sys rules go by path: nothing of them is mounted anywhere else.
  deny mount /{proc,sys}{,/**} -> /**,
  deny mount options=(rw, bind) /run/remote-browser/*/root/proc{,/**} -> /**,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (receive) peer=docker-default,
  signal (send,receive) peer=remote-claude-browser,
  ptrace (trace,read,tracedby,readby) peer=remote-claude-browser,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
