[Unit]
Description=Private display for Claude browser

[Service]
User=claude-browser
Slice=claude-browser.slice
Group=claude-browser
ExecStart=/usr/bin/Xvfb :99 -screen 0 1440x1000x24 -nolisten tcp -noreset
Restart=always
RestartSec=2
CPUQuota=20%
CPUWeight=10
Nice=10
MemoryHigh=96M
MemoryMax=128M
MemorySwapMax=0
TasksMax=16

[Install]
WantedBy=multi-user.target
