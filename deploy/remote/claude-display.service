[Unit]
Description=Private display for Claude browser

[Service]
User=claude-browser
Slice=claude-browser.slice
Group=claude-browser
ExecStart=/usr/bin/Xvfb :99 -screen 0 12800x3840x24 -nolisten tcp -noreset
Restart=always
RestartSec=2
CPUQuota=150%
CPUWeight=20
Nice=10
MemoryHigh=512M
MemoryMax=640M
MemorySwapMax=0
TasksMax=16

[Install]
WantedBy=multi-user.target
