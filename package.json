{
  "name": "remote-browser",
  "version": "0.1.0",
  "description": "Run Chromium remotely and rebuild its pages as a scriptless interactive mirror",
  "private": true,
  "license": "Apache-2.0",
  "author": "mystxcal",
  "keywords": [
    "remote-browser",
    "rrweb",
    "chromium",
    "semantic-dom",
    "cdp"
  ],
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.23.1 <23",
    "pnpm": "9.15.9"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.8",
      "find-my-way": "9.7.0"
    },
    "patchedDependencies": {
      "@rrweb/record@2.1.1": "patches/@rrweb__record@2.1.1.patch",
      "@rrweb/replay@2.1.1": "patches/@rrweb__replay@2.1.1.patch"
    }
  },
  "scripts": {
    "build": "bash scripts/limited-run.sh pnpm -r --workspace-concurrency=1 --if-present run build",
    "typecheck": "bash scripts/limited-run.sh pnpm -r --workspace-concurrency=1 --if-present run typecheck",
    "test": "bash scripts/limited-run.sh pnpm -r --workspace-concurrency=1 --if-present run test",
    "test:remote": "bash scripts/limited-run.sh node scripts/remote-smoke.mjs",
    "format": "bash scripts/limited-run.sh bash -c 'prettier --write .'",
    "format:check": "bash scripts/limited-run.sh bash -c 'prettier --check .'",
    "audit:prod": "bash scripts/limited-run.sh bash -c 'pnpm audit --prod --audit-level high'",
    "check:rrweb": "bash scripts/limited-run.sh bash -c 'node scripts/check-rrweb-versions.mjs'",
    "test:p2-diff": "bash scripts/limited-run.sh bash -c 'tsx --test scripts/mirror-diff/*.test.ts'",
    "p2-diff:run": "bash scripts/limited-run.sh bash -c 'tsx scripts/mirror-diff/index.ts'",
    "p2-diff:oopif": "bash scripts/limited-run.sh bash -c 'P2_DIFF_OOPIF=1 pnpm run p2-diff:run'",
    "p2-diff:ci": "bash scripts/limited-run.sh bash -c 'node scripts/p2-diff-ci.mjs default'",
    "p2-diff:oopif:ci": "bash scripts/limited-run.sh bash -c 'node scripts/p2-diff-ci.mjs oopif'",
    "p2-diff": "bash scripts/limited-run.sh bash -c 'pnpm run build && pnpm run p2-diff:run'",
    "p2-diff:real": "bash scripts/limited-run.sh bash -c 'pnpm run build && P2_DIFF_REAL_SITES=1 pnpm run p2-diff:run'",
    "p2-resync:chaos": "bash scripts/limited-run.sh bash -c 'tsx scripts/p2-resync-chaos.ts'",
    "p2-resync:chaos:10m": "bash scripts/limited-run.sh bash -c 'tsx scripts/p2-resync-chaos.ts --ten-minutes'",
    "test:rtc-media": "bash scripts/limited-run.sh bash -c 'tsx scripts/rtc-media-acceptance.ts'",
    "smoke": "bash scripts/limited-run.sh bash -c 'tsx scripts/smoke.ts'",
    "smoke:compose": "bash scripts/limited-run.sh bash -c 'bash scripts/compose-smoke.sh'",
    "check:host": "bash scripts/limited-run.sh bash -c 'bash scripts/check-host.sh'",
    "bootstrap": "bash scripts/limited-run.sh bash -c 'bash scripts/bootstrap.sh'",
    "invite": "bash scripts/limited-run.sh bash -c 'tsx scripts/invite.ts'",
    "ci": "bash scripts/limited-run.sh bash -c 'node scripts/check-rrweb-versions.mjs && pnpm run build && pnpm run typecheck && pnpm run test && pnpm run test:rtc-media && pnpm run test:p2-diff && pnpm run p2-diff:ci && pnpm run p2-diff:oopif:ci && pnpm run format:check'",
    "dev": "bash scripts/limited-run.sh pnpm --filter @mirror/viewer run dev"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
